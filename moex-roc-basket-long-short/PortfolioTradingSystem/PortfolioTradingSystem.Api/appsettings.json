{
  "Urls": "http://localhost:5080",
  "Strategy": {
    "RocBars": 5,
    "RocThreshold": 0.01,
    "AtrPeriod": 14,
    "SlAtr": 2.0,
    "TpAtr": 3.0,
    "RiskPct": 10.0,
    "CommissionPct": 0.04,
    "PointRub": 1.0,
    "Leverage": 1.0,
    "InitialCapital": 100000,
    "ShortsEnabled": true
  },
  "Tinkoff": {
    "ApiUrl": "https://invest-public-api.tbank.ru:443",
    "AccessToken": "",
    "SandboxMode": false,
    "HistoricMaxBars": 700,
    "ResolveClassCode": "TQBR"
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "ChannelId": ""
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=portfolio_trading;Username=postgres;Password=root"
  },
  "Admin": {
    "Username": "admin",
    "Password": "admin",
    "Realm": "portfolio-trading"
  },
  "Engine": {
    "RefreshInstrumentsIntervalSeconds": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc.Net.Client": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}