<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PortfolioTradingSystem.Application\PortfolioTradingSystem.Application.csproj" />
    <ProjectReference Include="..\PortfolioTradingSystem.Infrastructure\PortfolioTradingSystem.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Admin\admin.html" />
    <EmbeddedResource Include="Admin\chart.html" />
    <EmbeddedResource Include="Admin\equity.html" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Emitted as [assembly: AssemblyMetadata("BuildDate", ...)] and shown in the
      admin panel header (AdminPage replaces the $BUILD_LABEL$ token).
    -->
    <AssemblyMetadata Include="BuildDate"
                      Value="$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd HH:mm'))" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d3970286-6d4c-4927-9b11-fb4bd5ea9553</UserSecretsId>
  </PropertyGroup>

</Project>
